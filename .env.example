# Ironjaw environment variables (optional — config in ironjaw.toml is primary)
# Copy to .env and fill in values.

# Auth token for WebSocket connections
IRONJAW_AUTH_TOKEN=change-me-to-a-secure-token

# Home Assistant (optional)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# LLM providers (optional — defaults to localhost:8080)
OPENAI_API_KEY=sk-...

# llama-server endpoint (default: http://localhost:8080)
LLAMA_SERVER_URL=http://localhost:8080

# docker-host SSH (for infra tools)
REMOTE_HOST=192.0.2.20
REMOTE_USER=deploy
