#!/usr/bin/env bash
# Ironjaw pre-commit hook
# Runs secret scanning, cargo fmt, and cargo clippy on staged files.
# Install: ./hooks/install.sh

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── Secret scanning ──────────────────────────────────────────────────
echo -e "${YELLOW}[pre-commit]${NC} Scanning for secrets..."

SECRET_PATTERNS=(
    'sk-ant-[a-zA-Z0-9_-]+'
    'sk-[a-zA-Z0-9]{20,}'
    'AIzaSy[a-zA-Z0-9_-]{33}'
    'pplx-[a-zA-Z0-9]{48}'
    'ghp_[a-zA-Z0-9]{36}'
    'gho_[a-zA-Z0-9]{36}'
    'BEGIN PRIVATE KEY'
    'BEGIN RSA PRIVATE KEY'
    'BEGIN EC PRIVATE KEY'
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
FOUND_SECRETS=0

for file in $STAGED_FILES; do
    # Skip .example files and binary files
    case "$file" in
        *.example|*.lock|*.png|*.jpg|*.ico|*.woff*) continue ;;
    esac

    if [ ! -f "$file" ]; then
        continue
    fi

    for pattern in "${SECRET_PATTERNS[@]}"; do
        if grep -qE "$pattern" "$file" 2>/dev/null; then
            echo -e "${RED}[BLOCKED]${NC} Potential secret in ${file}: matches '${pattern}'"
            FOUND_SECRETS=1
        fi
    done
done

if [ "$FOUND_SECRETS" -eq 1 ]; then
    echo -e "${RED}[pre-commit]${NC} Secret scan failed. Remove secrets before committing."
    exit 1
fi
echo -e "${GREEN}[pre-commit]${NC} Secret scan passed."

# ── Check if any Rust files are staged ───────────────────────────────
RS_STAGED=$(echo "$STAGED_FILES" | grep '\.rs$' || true)

if [ -z "$RS_STAGED" ]; then
    echo -e "${GREEN}[pre-commit]${NC} No .rs files staged, skipping fmt/clippy."
    exit 0
fi

# ── cargo fmt ────────────────────────────────────────────────────────
echo -e "${YELLOW}[pre-commit]${NC} Running cargo fmt --all --check..."
if ! cargo fmt --all --check 2>/dev/null; then
    echo -e "${RED}[pre-commit]${NC} Formatting check failed. Run 'cargo fmt --all' to fix."
    exit 1
fi
echo -e "${GREEN}[pre-commit]${NC} Formatting check passed."

# ── cargo clippy ─────────────────────────────────────────────────────
echo -e "${YELLOW}[pre-commit]${NC} Running cargo clippy..."
if ! cargo clippy --workspace --all-targets -- -D warnings 2>/dev/null; then
    echo -e "${RED}[pre-commit]${NC} Clippy check failed. Fix warnings before committing."
    exit 1
fi
echo -e "${GREEN}[pre-commit]${NC} Clippy check passed."

echo -e "${GREEN}[pre-commit]${NC} All checks passed."
